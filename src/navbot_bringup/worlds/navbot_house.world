<?xml version="1.0" ?>
<!--
  ============================================================================
  navbot_house.world —— 复杂室内场景（5 个房间 + 走廊 + 家具）
  ============================================================================
  ★ 来源：TurtleBot3 官方仿真世界 turtlebot3_house
      https://github.com/ROBOTIS-GIT/turtlebot3_simulations
      branch humble @ a35a56c8b04877dc89772b598084d8ce648a9023
      turtlebot3_gazebo/worlds/turtlebot3_house.world
      turtlebot3_gazebo/models/turtlebot3_house/model.sdf
        （model.sdf blob 454487361a5936ffc2e03530bdaf155bd6b47a98）

  ★ 为什么把它内联进这个文件，而不是 <include><uri>model://...</uri></include>：
    1. model:// 依赖 GAZEBO_MODEL_PATH，换台机器/换 shell 就找不到模型，
       报错是 "Unable to find model ..."，和「仿真起不来」混在一起很难查；
    2. 内联后这个 world 是自包含的，拷贝到任何机器上 gazebo world 都能开；
    3. 代价是文件 180 KB —— 纯文本、纯 box 几何，diff 可读，值得。

  ★ 和 navbot_room.world 的关系：
    房间（6×5 m、2 个隔断）用来调试单个机制（窄缝、原地转、膨胀参数）；
    这个房子（15×10.5 m、5 个房间、门宽 0.8~1.0 m）用来测「复杂路径」：
    绕远路、穿门、多房间连续导航 —— 房间图里根本没有「两条路可选」的场合。

  ★ 家具高度说明（会被 2D 雷达「看穿」）：
    模型里桌子/床是 0.4~0.5 m 高的 box，而 navbot 的激光平面在 0.10~0.12 m。
    所以雷达实际只看到桌腿（或者完全看不到）—— 这是 2D 激光的真实行为，
    不是 bug。真机上桌子也确实「钻得进去」，代价是视觉上会看到车穿桌腿。
  ============================================================================
-->
<sdf version="1.6">
  <world name="navbot_house">

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- 物理：沿用 TurtleBot3 官方世界的 ODE quick 求解器。
         房子里有 194 个静态 box，用默认求解器也能跑，但 quick+150 次迭代
         是官方验证过的配置，不折腾。 -->
    <!-- 物理：★★ 2026-11-16 换成和 navbot_room.world 完全一样的默认 ODE 配置。
         原来照搬的是 TurtleBot3 官方的 quick 求解器那套（iters 150 / sor 1.4 /
         contact_surface_layer 1 cm）。TB3 用它没问题，但 navbot 在这套参数下
         **轮子一直打滑**：命令 0.15 m/s，真值只走 0.02 m/s，6 秒走 13 cm。
         证据（2026-11-16 实测）：
           · /joint_states 轮速 = 命令值，但 gz model -p 的真值位姿几乎不动
           · 换到房间世界同一台车、同一条命令 → 正常
           · 唯一变量就是这个 physics 块
         1 cm 的 contact_surface_layer 对 3.25 cm 半径的小轮子来说太软，
         接触还没"硬"起来轮子就已经转过去了。
         ⇒ 仿真世界的物理参数应该跟机器人尺寸匹配，不能照抄 TB3。 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>-1.0 -1.0 8.5 0 1.45 0.6</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ==================================================================
         房子本体（内联的 turtlebot3_house 模型）
         ================================================================== -->
    <model name="turtlebot3_house">
<link name='Wall_101'>
  <pose frame=''>-0.05 3.1 0 0 0 -1.5708</pose>
  <self_collide>0</self_collide>
  <kinematic>0</kinematic>
  <visual name='Wall_101_Visual'>
    <pose frame=''>0 0 1.25 0 -0 0</pose>
    <geometry>
      <box>
        <size>4.5 0.15 2.5</size>
      </box>
    </geometry>
    <material>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>Gazebo/Bricks</name>
      </script>
      <ambient>1 1 1 1</ambient>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <emissive>0 0 0 1</emissive>
    </material>
    <cast_shadows>1</cast_shadows>
    <transparency>0</transparency>
  </visual>
  <collision name='Wall_101_Collision'>
    <laser_retro>0</laser_retro>
    <max_contacts>10</max_contacts>
    <pose frame=''>0 0 1.25 0 -0 0</pose>
    <geometry>
      <box>
        <size>4.5 0.15 2.5</size>
      </box>
    </geometry>
    <surface>
      <friction>
        <ode>
          <mu>1</mu>
          <mu2>1</mu2>
          <fdir1>0 0 0</fdir1>
          <slip1>0</slip1>
          <slip2>0</slip2>
        </ode>
        <torsional>
          <coefficient>1</coefficient>
          <patch_radius>0</patch_radius>
          <surface_radius>0</surface_radius>
          <use_patch_radius>1</use_patch_radius>
          <ode>
            <slip>0</slip>
          </ode>
        </torsional>
      </friction>
      <bounce>
        <restitution_coefficient>0</restitution_coefficient>
        <threshold>1e+06</threshold>
      </bounce>
      <contact>
        <collide_without_contact>0</collide_without_contact>
        <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
        <collide_bitmask>1</collide_bitmask>
        <ode>
          <soft_cfm>0</soft_cfm>
          <soft_erp>0.2</soft_erp>
          <kp>1e+13</kp>
          <kd>1</kd>
          <max_vel>0.01</max_vel>
          <min_depth>0</min_depth>
        </ode>
        <bullet>
          <split_impulse>1</split_impulse>
          <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
          <soft_cfm>0</soft_cfm>
          <soft_erp>0.2</soft_erp>
          <kp>1e+13</kp>
          <kd>1</kd>
        </bullet>
      </contact>
    </surface>
  </collision>
</link>
