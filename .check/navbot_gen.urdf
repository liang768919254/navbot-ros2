<!--
  ============================================================================
  navbot.urdf.xacro —— 顶层装配文件（仿真用）
  ============================================================================
  它只干一件事：把「模型」和「仿真挂载层」拼在一起，然后交给 xacro 展开。

  ★ 为什么要单独一个顶层文件，不把两个合一个？
    因为这层「拼装」是唯一随场景变化的东西：
      仿真  → navbot.urdf.xacro        （含 gazebo 插件）
      真机  → navbot.urdf.xacro 的"去掉 include 第二行"版本
    有了这层，navbot.xacro（模型本体）在仿真和真机之间完全复用 —— 一字不改。

  校验：
    xacro navbot.urdf.xacro > /tmp/navbot_check.urdf
    check_urdf /tmp/navbot_check.urdf
  ===========================================================================
-->
<robot name="navbot">
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- base_footprint 贴地，base_link 再抬半个车厚 -->
    <origin rpy="0 0 0" xyz="0.0 0.0 0.05"/>
  </joint>
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.30 0.24 0.06"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.30 0.24 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00612" ixy="0.0" ixz="0.0" iyy="0.00936" iyz="0.0" izz="0.01476"/>
    </inertial>
  </link>
  <link name="left_wheel_link">
    <visual>
      <!-- 以弧度为单位指定滚动、俯仰和偏航旋转。 -->
      <!-- 格式：rpy="横滚 俯仰 偏航"（以空格分隔的值）
                    注意：旋转顺序为：偏航（Z轴）、俯仰（Y轴）、滚转（X轴） -->
      <!-- 圆柱的默认轴沿 Z。但轮子要「横躺」着滚，轴得朝 Y。所以要绕 X 轴转 -90°。 -->
      <origin rpy="-1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder length="0.026" radius="0.0325"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="-1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder length="0.026" radius="0.0325"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="0.15"/>
      <inertia ixx="4.8059375e-05" ixy="0.0" ixz="0.0" iyy="4.8059375e-05" iyz="0.0" izz="7.921875e-05"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.08 -0.0175"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="5.0" velocity="20.0"/>
  </joint>
  <link name="right_wheel_link">
    <visual>
      <!-- 以弧度为单位指定滚动、俯仰和偏航旋转。 -->
      <!-- 格式：rpy="横滚 俯仰 偏航"（以空格分隔的值）
                    注意：旋转顺序为：偏航（Z轴）、俯仰（Y轴）、滚转（X轴） -->
      <!-- 圆柱的默认轴沿 Z。但轮子要「横躺」着滚，轴得朝 Y。所以要绕 X 轴转 -90°。 -->
      <origin rpy="-1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder length="0.026" radius="0.0325"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="-1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder length="0.026" radius="0.0325"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="0.15"/>
      <inertia ixx="4.8059375e-05" ixy="0.0" ixz="0.0" iyy="4.8059375e-05" iyz="0.0" izz="7.921875e-05"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.08 -0.0175"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="5.0" velocity="20.0"/>
  </joint>
  <link name="front_caster_link">
    <visual>
      <!-- 以弧度为单位指定滚动、俯仰和偏航旋转。 -->
      <!-- 格式：rpy="横滚 俯仰 偏航"（以空格分隔的值）
                    注意：旋转顺序为：偏航（Z轴）、俯仰（Y轴）、滚转（X轴） -->
      <!-- 球心离地 = 半径 0.015，那相对 base_link 的 z = ？前后位置 x_pos = ±0.115。 -->
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="0.03"/>
      <inertia ixx="2.7e-06" ixy="0.0" ixz="0.0" iyy="2.7e-06" iyz="0.0" izz="2.7e-06"/>
    </inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.115 0 -0.035"/>
  </joint>
  <link name="back_caster_link">
    <visual>
      <!-- 以弧度为单位指定滚动、俯仰和偏航旋转。 -->
      <!-- 格式：rpy="横滚 俯仰 偏航"（以空格分隔的值）
                    注意：旋转顺序为：偏航（Z轴）、俯仰（Y轴）、滚转（X轴） -->
      <!-- 球心离地 = 半径 0.015，那相对 base_link 的 z = ？前后位置 x_pos = ±0.115。 -->
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="0.03"/>
      <inertia ixx="2.7e-06" ixy="0.0" ixz="0.0" iyy="2.7e-06" iyz="0.0" izz="2.7e-06"/>
    </inertial>
  </link>
  <joint name="back_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_caster_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.115 0 -0.035"/>
  </joint>
  <!-- 必须叫 laser_link（不是 lidar_link）：gazebo.xacro 里的雷达插件
         用 reference="laser_link" 挂接，改名会导致 TF 树断链 -->
  <link name="laser_link">
    <visual>
      <origin xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.04" radius="0.035"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.04" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="0.1"/>
      <inertia ixx="4.395833333333334e-05" ixy="0.0" ixz="0.0" iyy="4.395833333333334e-05" iyz="0.0" izz="6.125000000000001e-05"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin rpy="0 0 0" xyz="0.04 0 0.05"/>
  </joint>
  <!-- ==========================================================================
       ① 底盘：Gazebo 需要给整个模型一个「根」。
          真机上你不需要这段，这是仿真特有的。
          ★ <gazebo reference="base_footprint"> 必须和模型根 link 同名。
       ========================================================================== -->
  <gazebo reference="base_footprint"/>
  <!-- ==========================================================================
       ② 材质显示（可选，好看而已）
       ========================================================================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="laser_link">
    <material>Gazebo/Red</material>
  </gazebo>
  <!-- 轮子摩擦力：★ 这个不是装饰！默认 urdf 轮子摩擦力偏小，
       仿真里会出现「原地打滑 / 车不动但轮在转」，是新手最常见的仿真假故障。 -->
  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <!-- ==========================================================================
       ③ ★★ 差速驱动插件 —— 仿真里「虚机底盘」的替身
          ★ 参数名以本机头文件为准：
            /opt/ros/humble/include/gazebo_plugins/gazebo_ros_diff_drive.hpp
            里那段 Example Usage 就是权威清单，别照抄网络教程里的 ROS1 写法。
       ========================================================================== -->
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="diff_drive">
      <ros>
        <!-- 不加命名空间，话题直接落在 /cmd_vel、/odom -->
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <!-- 插件的计算频率。50Hz 足够，太高会拖慢仿真 -->
      <update_rate>50</update_rate>
      <!-- ★ 这两个名字必须和 navbot.xacro 里的 joint 名完全一致，
           写错的表现是：仿真里车纹丝不动，而 Gazebo 日志里
           有一行 "Joint [...] not found"，很容易被忽略 -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <!-- ★★ 运动学三件套 —— 必须和 URDF 里的尺寸一致，
           否则算出来的里程计是系统偏差（车实际走 1m，/odom 报 0.9m）。
           本模型：wheel_sep=0.16，wheel_r=0.0325 → diameter=0.065 -->
      <wheel_separation>0.16</wheel_separation>
      <wheel_diameter>0.065</wheel_diameter>
      <!-- 力矩上限与加速度上限：太小爬不上坡，太大会瞬间打滑 -->
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <!-- 输入 -->
      <command_topic>cmd_vel</command_topic>
      <!-- 输出：★ publish_odom_tf 是整个 TF 树能不能闭合的关键
           true  → 插件自己广播 odom → base_footprint
           false → 这棵树就断在 odom，Nav2 会一直报
                   "Timed out waiting for transform from base_footprint to odom" -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>
  <!-- ==========================================================================
       ④ 关节状态发布器 —— 让轮子在 RViz / TF 里真的转起来
          没有它，/joint_states 是空的，RViz 里模型两个轮子永远不动。
       ========================================================================== -->
  <gazebo>
    <plugin filename="libgazebo_ros_joint_state_publisher.so" name="joint_state_publisher">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  <!-- ==========================================================================
       ⑤ ★★ 单线激光雷达（gpu_ray）
          ★ 参数名以本机头文件为准：
            /opt/ros/humble/include/gazebo_plugins/gazebo_ros_ray_sensor.hpp
          两个关键参数：
            <output_type>  sensor_msgs/LaserScan  ← 不写默认是 PointCloud2，
                           那样 /scan 话题根本不会出现，Nav2 直接瞎。
            <frame_name>   laser_link  ← 不写就取「父 link 名」，
                           恰好也是 laser_link，但显式写出来更保险。
       ========================================================================== -->
  <gazebo reference="laser_link">
    <!-- ★ 无头环境（容器/服务器，无 X11 显示）必须用 ray（CPU 激光）而非 gpu_ray。
         gpu_ray 依赖 GPU 渲染引擎，无头时 RenderEngine 被禁用（render path NONE），
         传感器发不出光线 → /scan 话题一直 empty。
         ray 走 CPU 光线投射，无头也能跑；有 GPU 的桌面环境想更快再换回 gpu_ray。 -->
    <sensor name="laser" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <!-- 360 线，水平全向扫描 —— 和 RPLIDAR A1 一致 -->
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- ★ 量程必须比「地图最大尺寸」大，否则走廊尽头的墙看不见。
               同时不能小于 Nav2 参数里的 raytrace_max_range，
               否则代价地图会一直「擦不掉」已经走过的障碍 -->
          <min>0.12</min>
          <max>12.0</max>
        </range>
        <noise>
          <!-- 加噪声很重要：零噪声的完美激光会让你在仿真里调得很顺、
               上真机立刻崩。这里模拟 RPLIDAR 的典型 σ。 -->
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="laser_controller">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
